  box-shadow: none;
  border: 1rpx solid #eee;
}
.play-preview .card-art {
  height: 96rpx;
}
.play-preview .card-name {
  font-size: 22rpx;
}
.play-preview .card-short {
  font-size: 17rpx;
}
.targets {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}
.target {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 11rpx;
  width: calc(50% - 8rpx);
  min-height: 200rpx;
  padding: 20rpx 10rpx;
  box-sizing: border-box;
  font-size: 21rpx;
  line-height: 1.5;
}
.target .avatar {
  width: 98rpx;
  height: 98rpx;
}
.target .strong {
  font-size: 24rpx;
}
.target.chosen {
  outline: none;
  border: 3rpx solid #0071e3;
  background: #edf6ff;
}
.motion-tile {
  position: relative;
  width: 440rpx;
  box-sizing: border-box;
  padding: 34rpx 40rpx;
  animation-duration: 5s;
}
.motion-tile .card {
  width: 320rpx;
  box-shadow: none;
  border: 1rpx solid #eee;
}
.motion-tile .card-art {
  height: 210rpx;
}
.motion-tile .card-name {
  font-size: 39rpx;
  margin-top: 15rpx;
}
.motion-tile .card-short {
  font-size: 24rpx;
}
.motion-layer.nope .motion-tile {
  animation-duration: 5s;
}
.motion-layer.draw .motion-tile,
.motion-layer.future .motion-tile {
  animation-duration: 1.6s;
}
.motion-count {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #0066cc;
  color: #fff;
  border-radius: 24rpx;
  padding: 9rpx 18rpx;
  font-weight: 600;
}
@keyframes card-arrive {
  0% {
    opacity: 0;
    transform: translateY(112rpx) rotate(-5deg) scale(0.92);
  }
  10%,
  94% {
    opacity: 1;
    transform: none;
  }
  100% {
    opacity: 0;
    transform: translateY(-22rpx);
  }
}
@keyframes nope-stamp {
  0% {
    opacity: 0;
    transform: scale(1.15) rotate(-7deg);
  }
  10%,
  94% {
    opacity: 1;
    transform: none;
  }
  100% {
    opacity: 0;
  }
}
.reduced .motion-tile {
  animation: none !important;
}

.setting-label {
  font-size: 26rpx;
  font-weight: 600;
  margin: 26rpx 0 14rpx;
}
.nope-options {
  display: flex;
  padding: 6rpx;
  background: #f0f0f4;
  border-radius: 26rpx;
  gap: 6rpx;
}
button.nope-option {
  flex: 1;
  width: 0 !important;
  min-height: 44px !important;
  padding: 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 20rpx;
  color: #626570;
}
button.nope-option.chosen {
  background: #fff;
  color: #0066cc;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx #1d1d1f0d;
}
.setting-note {
  font-size: 22rpx;
  color: #858893;
  margin-top: 12rpx;
}
.close-room-option {
  margin-top: 32rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #e8e8ed;
  font-size: 25rpx;
}
button.danger-secondary,
button.danger-primary {
  width: 100% !important;
  margin-top: 20rpx !important;
  min-height: 44px !important;
  font-weight: 600;
  color: #b62f32;
  background: #fff1f1;
}
button.danger-primary {
  background: #bc3639;
  color: #fff;
}

.nope-banner {
  display: flex; align-items: center; justify-content: space-between; gap: 12rpx;
  height: 110rpx; box-sizing: border-box; padding: 8rpx 18rpx; margin-bottom: 26rpx;
  border: 1rpx solid #ececef; border-radius: 34rpx; background: #f7f7f9; color: #1d1d1f;
}
.nope-banner-copy { flex: 1; min-width: 0; }
.nope-banner-copy .strong { font-size: 27rpx; line-height: 1.2; margin-bottom: 9rpx; white-space: nowrap; }
.nope-timer-line { display: flex; align-items: center; gap: 8rpx; }
.nope-progress { flex: 1; max-width: 125rpx; min-width: 52rpx; height: 8rpx; overflow: hidden; border-radius: 999rpx; background: #dce7f5; }
.nope-progress > view { height: 100%; background: #0071e3; border-radius: inherit; transition: width .25s linear; }
.nope-timer-text { color: #687589; font-size: 21rpx; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
.nope-choices { display: flex; align-items: center; gap: 9rpx; flex-shrink: 0; }
.nope-choices button.nope-choice { display: flex !important; align-items: center; justify-content: center; text-align: center; width: auto !important; min-width: 142rpx; min-height: 88rpx; margin: 0 !important; padding: 10rpx 15rpx; font-family: "Yuanti SC", "Hiragino Maru Gothic ProN", "PingFang SC", sans-serif; font-size: 26rpx; font-weight: 600; line-height: 1.25; background: #fff; border-color: #dce1e9; white-space: nowrap; }
.nope-choices button.nope-play:not([disabled]) { border-color: #a7caff; background: #f0f6ff; }
.nope-choices button.nope-choice[disabled] { opacity: 1; color: #a1a1aa; background: #f1f1f4; border-color: #e3e3e8; }
.nope-banner.urgent .nope-timer-text { color: #b63822; }
.nope-banner.urgent .nope-progress { background: #f6d8d0; }
.nope-banner.urgent .nope-progress > view { background: #bf452e; }

/* Full Imploding Kittens expansion, using the approved Apple light style. */
.card-symbol { position: absolute; top: 7rpx; right: 7rpx; display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 18rpx; background: #ffffffed; color: #1d1d1f; border: 1rpx solid #e0e0e0; font-size: 39rpx; font-weight: 600; line-height: 1; }
.board-center .card-symbol { width: 37rpx; height: 37rpx; font-size: 30rpx; top: 4rpx; right: 4rpx; border-radius: 13rpx; }
.table-direction { font-size: 21rpx; color: #637080; line-height: 1.5; }
.board-center .table-direction + .piles { margin-top: 11rpx; }
.deck-hazards { margin: 0 18rpx 18rpx; padding: 18rpx 22rpx; border: 1rpx solid #e8c2b9; border-radius: 30rpx; background: #fff5f2; color: #8e3828; font-size: 22rpx; line-height: 1.5; font-weight: 600; }
.future-order { display: flex; flex-direction: column; gap: 18rpx; margin: 22rpx 0; }
.future-order-row { display: flex; gap: 22rpx; align-items: center; }
.future-rank { color: #637080; width: 30rpx; font-size: 28rpx; text-align: center; flex-shrink: 0; }
.reorder-phase .future-order-row .card { width: 190rpx; border: 1rpx solid #e0e0e0; box-shadow: none; padding: 9rpx; }
.reorder-phase .card-art { height: 122rpx; }
.reorder-phase .card-name { font-size: 22rpx; margin: 9rpx 0 4rpx; }
.reorder-phase .card-short { font-size: 19rpx; line-height: 1.3; display: block; }
.future-moves { display: flex; flex-direction: column; gap: 11rpx; flex: 1; min-width: 0; }
.future-moves .future-move { min-height: 88rpx; margin: 0; padding: 15rpx; font-size: 24rpx; }
.card-state { position: absolute; bottom: 5rpx; left: 5rpx; padding: 4rpx 9rpx; border: 1rpx solid #e0e0e0; border-radius: 13rpx; background: #ffffffed; color: #333333; font-size: 19rpx; line-height: 1.3; font-weight: 600; }
.card-state.face-up { border-color: #e8c2b9; background: #fff5f2; color: #8e3828; }
.hero-count { position: absolute; left: 4.5%; top: 22%; width: 30%; min-height: 82rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: #fff0cf; color: #5b493a; font-size: 44rpx; font-weight: 600; line-height: 1.2; }
.hero-rules-note { margin: -22rpx 0 37rpx; color: #637080; font-size: 22rpx; line-height: 1.5; text-align: center; }

/* Approved v3: the action tile belongs to the common table, not the hand. */
.board-stage .motion-layer { position: absolute; z-index: 8; }
.motion-tile { width: 490rpx; max-width: 76%; padding: 22rpx 24rpx; }
.motion-people { display: flex; align-items: center; justify-content: center; gap: 22rpx; margin-bottom: 10rpx; color: #0066cc; font-size: 46rpx; }
.motion-people .avatar { width: 68rpx; height: 68rpx; flex-shrink: 0; }
.motion-relationship { font-size: 44rpx; font-weight: 700; line-height: 1.2; word-break: break-all; }
.motion-action { font-size: 42rpx; font-weight: 600; line-height: 1.25; color: #0066cc; margin: 6rpx 0 15rpx; word-break: break-all; }
.motion-tile .card { width: 250rpx; margin: 0 auto; }
.motion-tile .card-art { height: 165rpx; }
.motion-tile .card-name { font-size: 30rpx; margin-top: 9rpx; }
.motion-tile .card-short { font-size: 21rpx; }
.motion-count { top: 7rpx; right: 9rpx; font-size: 21rpx; padding: 4rpx 9rpx; }
.reduced .nope-progress > view { transition: none; }

/* Approved compact first screen; reserve space beneath scrollable private phases. */
.table-playing.game-shell { padding: 20rpx 28rpx calc(296rpx + env(safe-area-inset-bottom)); }
.table-playing > .top { margin-bottom: 12rpx; }
.table-playing .game-room { padding-bottom: 16rpx; }
.table-playing .board-stage {
  height: calc(100vh - 400px - env(safe-area-inset-bottom));
  min-height: 440rpx;
  max-height: 580rpx;
}
.table-playing .hand-caption { height: 84rpx; }
.table-playing .hand-row { padding-top: 30rpx; padding-bottom: 16rpx; }
.table-playing .hand .card { height: 260rpx; }
.table-playing .card-spine { top: 12rpx; bottom: 12rpx; padding: 10rpx 7rpx; font-size: 24rpx; line-height: 1.25; }
.table-playing .selection-preview { min-height: 0; padding: 8rpx 0; }
.table-playing .table-dock {
  position: fixed;
  z-index: 6;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
}
.table-playing .table-dock .nope-banner { margin: 0 46rpx 16rpx; }
.table-playing .table-actions {
  display: flex;
  flex-wrap: nowrap;
  gap: 20rpx;
  padding: 20rpx 36rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #efeff4;
}
.table-playing .table-actions > button {
  display: block !important;
  flex: 1.8 1 0;
  width: 0 !important;
  min-height: 48px;
  border-radius: 50rpx;
  font-size: 30rpx;
  padding: 16rpx 10rpx !important;
  margin: 0 !important;
  line-height: 1.5;
}
.table-playing .table-actions > .secondary { flex: 1 1 0; border: 1rpx solid #0071e3; color: #0071e3; background: #fff; }
.table-playing .table-actions > .primary { background: #0071e3 !important; color: #fff !important; }
.table-playing .table-actions > .primary[disabled] { background: #b4c7ef !important; color: #fff !important; opacity: 1; }

.expansion-settings { padding: 0 28rpx; background: #f5f5f7; border: 1rpx solid #e8e8ed; border-radius: 36rpx; }
.expansion-settings .switch { padding: 0; min-height: 104rpx; gap: 24rpx; }
.expansion-settings .switch + .switch { border-top: 1rpx solid #e8e8ed; }

/* Highlight only a choice this player can still make; no pulsing or layout shift. */
.nope-banner.awaiting { background: #eaf3ff; border-color: #0071e3; }

/* The home fits the viewport; only artwork gives up space on short screens. */
.home-shell { height: 100vh;  min-height: 0; padding: 12px 18px max(16px, env(safe-area-inset-bottom)); overflow: hidden; position: relative; }
.home-lobby { height: 100%; min-height: 0; display: flex; flex-direction: column; }
.home-shell .home-hero { flex: 1; min-height: 0; height: auto; margin: 0; border-radius: 0; display: flex; align-items: center; justify-content: center; }
.home-hero-art { position: relative; width: 100%; max-width: calc(86.4vh - 254px);  aspect-ratio: 0.864; overflow: hidden; border-radius: 24px; flex-shrink: 0; }
.has-resume .home-hero-art { max-width: calc(86.4vh - 305px);  }
.home-shell .hero-count { min-height: 0; height: 11%; font-size: clamp(12px, 4.2vw, 24px); border-radius: 8px; }
.home-shell .hero-rules-note { flex-shrink: 0; margin: 8px 0 12px; font-size: 11px; line-height: 16px; }
.home-controls { flex-shrink: 0; display: flex; flex-direction: column; gap: 12px; }
.home-shell .identity { height: 52px; gap: 12px; margin: 0; }
.home-shell .identity .avatar { width: 52px; height: 52px; }
.home-shell .name-field { flex: 1; min-width: 0; height: 48px; box-sizing: border-box; display: flex; align-items: center; padding: 0 14px; border: 1rpx solid #e3e3e8; border-radius: 28rpx; background: #fafafc; }
.home-shell .name-field input { flex: 1; min-width: 0; height: 24px; min-height: 0; line-height: 24px; padding: 0; border: 0; border-radius: 0; background: transparent; text-align: left; font-size: 16px; }
.home-actions { display: flex; flex-direction: column; gap: 10px; }
.home-shell .home-actions button { min-height: 48px; height: 48px; margin: 0; padding: 10px 16px; font-size: 17px; display: flex; align-items: center; justify-content: center; }
.home-footer { flex-shrink: 0; display: flex; align-items: center; justify-content: center; gap: 14px; height: 44px; margin-top: 8px; }
.home-footer .text-btn { min-height: 44px; margin: 0; padding: 0 12px; font-size: 14px; display: flex; align-items: center; justify-content: center; }
.home-footer .circle { width: 44px; min-height: 44px; height: 44px; font-size: 22px; padding: 0; display: flex; align-items: center; justify-content: center; }
.home-shell > .connections, .home-shell > .connection { display: none; }

.home-shell { position: fixed; top: 0; left: 0; right: 0; }
.home-shell .identity button.avatar { width: 52px !important; height: 52px !important; }
.home-shell .home-actions button { min-height: 48px !important; margin: 0 !important; display: flex !important; }
.home-footer button.text-btn { min-height: 44px !important; display: flex !important; }
.home-footer button.circle { width: 44px !important; height: 44px !important; min-height: 44px !important; padding: 0 !important; }

.home-shell { padding: 0; }
.home-shell .home-lobby { box-sizing: border-box; padding: 12px 18px max(16px, env(safe-area-inset-bottom)); }

/* Keep the turn summary below the piles so the top seat remains unobstructed. */
.table-playing .board-stage { min-height: 300px; }
.board-center { top: 52%; }
.board-center .piles { margin-top: 0; }
.board-center .turn-label { position: absolute; top: calc(100% + 15rpx); left: 50%; transform: translateX(-50%); width: 390rpx; padding: 0; flex-direction: row; align-items: center; justify-content: center; gap: 11rpx; line-height: 1.2; }
.board-center .turn-label > view + view { margin-top: 0; }

/* Larger hand artwork and labels within the existing card footprint. */
.hand .card-art { margin-left: 58rpx; width: calc(100% - 58rpx); height: 142rpx; border-radius: 15rpx; }
.hand .compact-hand .card-art { height: 110rpx; }
.hand-art-crop { position: absolute; top: 0; left: 50%; height: 100%; transform: translateX(-50%); overflow: hidden; }
.hand .card-name, .hand .card-short { margin-left: 58rpx; width: calc(100% - 58rpx); }
.hand .card-name { font-size: 26rpx; font-weight: 700; line-height: 1.15; margin-top: 6rpx; margin-bottom: 0; word-break: break-all; }
.hand .card-short { font-size: 21rpx; line-height: 1.15; margin-top: 4rpx; color: #505361; }
.hand .card-spine, .table-playing .card-spine { font-size: 28rpx; line-height: 1.2; padding: 11rpx 5rpx; }
.card-spine.tone-cat { background: #efe7fa; }
.card-spine.tone-defuse { background: #e6f3e2; }
.card-spine.tone-nope { background: #fce5e8; }
.card-spine.tone-attack { background: #fff0d8; }
.card-spine.tone-other { background: #e6f1fc; }

/* Bomb warning: one soft burst, then a stable, readable five-second card. */
.card.tone-bomb { position: relative; background: #fff1f2; border-color: #efb5b8; }
.card.tone-bomb::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 10rpx; border-radius: 28rpx 0 0 28rpx; background: #eda0a6; }
.hand .card.tone-bomb::before { display: none; }
.card-spine.tone-bomb { background: #f1b4b9; color: #d9182b; }
.card.tone-bomb > .card-name { color: #d9182b; font-weight: 700; }
.explosion .motion-tile { border-color: #efb5b8; background: #fffafa; box-shadow: 0 24rpx 72rpx #bd334323; }
.explosion .motion-relationship { font-size: 48rpx; font-weight: 700; }
.explosion .motion-action { color: #d9182b; font-size: 48rpx; font-weight: 700; }
.bomb-burst { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
.burst-ring { position: absolute; left: 50%; top: 50%; width: 560rpx; height: 560rpx; margin: -280rpx 0 0 -280rpx; border: 18rpx solid #f29b66; border-radius: 50%; background: radial-gradient(circle, transparent 45%, #ffd9a175 62%, #f498863d 65%, transparent 70%); animation: bomb-ring 900ms ease-out both; }
.burst-spark { position: absolute; left: 50%; top: 50%; width: 28rpx; height: 28rpx; margin: -14rpx 0 0 -14rpx; border-radius: 10rpx; background: #ef885b; opacity: 0; animation-duration: 850ms; animation-timing-function: ease-out; animation-fill-mode: both; }
.burst-spark.s1 { animation-name: bomb-spark-1; }
.burst-spark.s2 { animation-name: bomb-spark-2; }
.burst-spark.s3 { animation-name: bomb-spark-3; }
.burst-spark.s4 { animation-name: bomb-spark-4; }
.burst-spark.s5 { animation-name: bomb-spark-5; }
.burst-spark.s6 { animation-name: bomb-spark-6; }
@keyframes bomb-ring { 0% { opacity: 0; transform: scale(.25); } 20% { opacity: .85; } 100% { opacity: 0; transform: scale(1.22); } }
@keyframes bomb-spark-1 { 0% { opacity: 0; transform: scale(.3); } 20% { opacity: 1; } 100% { opacity: 0; transform: translate(290rpx,-170rpx) rotate(65deg) scale(.65); } }
@keyframes bomb-spark-2 { 0% { opacity: 0; transform: scale(.3); } 20% { opacity: 1; } 100% { opacity: 0; transform: translate(310rpx,30rpx) rotate(65deg) scale(.65); } }
@keyframes bomb-spark-3 { 0% { opacity: 0; transform: scale(.3); } 20% { opacity: 1; } 100% { opacity: 0; transform: translate(240rpx,210rpx) rotate(65deg) scale(.65); } }
@keyframes bomb-spark-4 { 0% { opacity: 0; transform: scale(.3); } 20% { opacity: 1; } 100% { opacity: 0; transform: translate(-290rpx,-170rpx) rotate(65deg) scale(.65); } }
@keyframes bomb-spark-5 { 0% { opacity: 0; transform: scale(.3); } 20% { opacity: 1; } 100% { opacity: 0; transform: translate(-310rpx,30rpx) rotate(65deg) scale(.65); } }
@keyframes bomb-spark-6 { 0% { opacity: 0; transform: scale(.3); } 20% { opacity: 1; } 100% { opacity: 0; transform: translate(-240rpx,210rpx) rotate(65deg) scale(.65); } }
 .reduced .bomb-burst { display: none; }
@media (prefers-reduced-motion: reduce) { .bomb-burst { display: none; } .explosion .motion-tile { animation: none; } }
