.motion-layer {
  position: fixed;
  inset: 0;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 19;
}
.motion-tile {
  border-radius: 38rpx;
  background: #fffffff5;
  padding: 30rpx 40rpx;
  text-align: center;
  border: 1rpx solid #e4e9ef;
  box-shadow: 0 20rpx 60rpx #2b385b1a;
  animation: card-arrive 0.8s ease both;
  font-size: 27rpx;
}
.motion-tile .card {
  width: 240rpx;
  margin: 0 auto 20rpx;
}
.motion-tile .card-art {
  height: 159rpx;
}
.motion-layer.nope .motion-tile {
  animation: nope-stamp 0.8s ease both;
}
.future .card {
  animation: future-flip 0.3s ease both;
}
.future .card:nth-child(2) {
  animation-delay: 0.06s;
}
.future .card:nth-child(3) {
  animation-delay: 0.12s;
}
@keyframes card-arrive {
  0% {
    opacity: 0;
    transform: translateY(140rpx) rotate(-8deg) scale(0.85);
  }
  20%,
  70% {
    opacity: 1;
    transform: none;
  }
  100% {
    opacity: 0;
    transform: translateY(-38rpx);
  }
}
@keyframes nope-stamp {
  0% {
    opacity: 0;
    transform: scale(1.22) rotate(-10deg);
  }
  20%,
  70% {
    opacity: 1;
    transform: none;
  }
  100% {
    opacity: 0;
  }
}
@keyframes future-flip {
  from {
    opacity: 0;
    transform: rotateY(90deg);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
.reduced .future .card {
  animation: none !important;
}

