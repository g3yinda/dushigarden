<template name="card"><view class="card-art"><view wx:if="{{hand}}" class="hand-art-crop" style="aspect-ratio:{{card.handRatio}};"><image src="/assets/{{card.source}}" mode="widthFix" style="{{card.handArt}}"/></view><image wx:else src="/assets/{{card.source}}" mode="widthFix" style="{{card.art}}"/><text wx:if="{{card.symbol}}" class="card-symbol" aria-hidden="true">{{card.symbol}}</text><text wx:if="{{card.stateLabel}}" class="card-state {{card.faceUp?'face-up':''}}">{{card.stateLabel}}</text></view><view class="card-name">{{card.name}}</view><view class="card-short">{{card.short}}</view></template>
<view class="shell {{!room?'home-shell':''}} {{settings.reduced?'reduced':''}} {{room.game?'game-shell':''}} {{room.game && room.game.phase !== 'finished'?'table-playing':''}}">
 <block wx:if="{{!room}}">
  <view class="home-lobby {{canResume?'has-resume':''}}" catchtouchmove="preventHomeScroll">
   <view class="hero home-hero"><view class="home-hero-art"><image src="/assets/ui.jpg" mode="widthFix" aria-label="2–6 人炸弹猫，可爱猫咪抱着炸弹"/><text class="hero-count">2–6 人</text></view></view>
   <view class="hero-rules-note">2–5 人基础版 · 6 人完整内爆猫扩展</view>
   <view class="home-controls"><view class="identity"><button class="avatar" data-action="profile" bindtap="action" aria-label="选择头像"><image src="/assets/ui.jpg" mode="widthFix" style="{{avatarStyle}}"/></button><view class="name-field"><input maxlength="12" value="{{name}}" placeholder="给自己起个名字" data-field="name" bindinput="input" aria-label="你的昵称"/></view></view>
    <view class="home-actions"><button wx:if="{{canResume}}" class="primary" data-action="resume" bindtap="action">返回正在进行的对局</button><button class="primary" data-action="create" bindtap="action" loading="{{busy}}" disabled="{{busy}}">创建房间</button><button class="secondary" data-action="join" bindtap="action" disabled="{{busy}}">加入房间</button></view>
   </view>
   <view class="home-footer"><button class="text-btn" data-action="rules" bindtap="action">玩法说明 ›</button><button class="circle" data-action="settings" bindtap="action" aria-label="设置">⚙</button></view>
  </view>
 </block>
 <block wx:elif="{{room.status === 'aborted'}}"><view class="heading">这局已中止</view><view class="muted space">请返回大厅，重新和朋友开一局。</view><button class="primary" data-action="leave-submit" bindtap="action">回大厅</button></block>
 <block wx:elif="{{!room.game}}">
  <view class="top"><button class="circle" data-action="leave" bindtap="action">‹</button><view class="heading">好友房</view><button class="circle" data-action="settings" bindtap="action">⚙</button></view>
  <view class="code"><view class="muted">房间号</view><view class="code-number">{{room.code}}</view><button class="text-btn" data-action="copy" bindtap="action">复制房间号 ↗</button><view class="muted">把房间号分享给朋友，一起来玩吧！</view></view>
  <view class="room-mode">{{v.rulesLabel}} · {{v.noTurnTimer?'∞ 出牌不限时':'出牌 30 秒'}} · 否定 {{v.nopeTimeLabel}}</view><view class="seats"><view wx:for="{{v.players}}" wx:key="id" class="seat"><view class="avatar"><image src="/assets/ui.jpg" mode="widthFix" style="{{item.avatarStyle}}"/></view><view class="strong">{{item.name}}{{item.isBot?' · Bot':''}}{{item.isMe?' · 你':''}}</view><view class="{{item.ready?'ready':'muted'}}">{{item.ready?'✓ 已准备':'◌ 等待准备'}}{{item.isHost?' · 房主':''}}</view><button wx:if="{{v.isHost && !item.isMe}}" class="remove" data-action="kick" data-id="{{item.id}}" bindtap="action">移出</button></view><view wx:if="{{room.players.length < 2}}" class="seat"><view class="empty-avatar">＋</view><view class="muted">等一位朋友</view></view></view>
  <button class="secondary" open-type="share">邀请朋友</button><button wx:if="{{v.canAddBots}}" class="secondary" data-action="bots" bindtap="action" disabled="{{busy}}">添加验证 Bot</button><button class="{{v.isHost?'secondary':'primary'}}" data-action="ready" bindtap="action" disabled="{{busy}}">{{v.ready?'取消准备':'我准备好了'}}</button><button wx:if="{{v.isHost}}" class="primary" data-action="start" bindtap="action" disabled="{{busy || !v.canStart}}">开始游戏</button><view wx:else class="muted center space">大家准备后，由房主开始游戏</view><view class="muted center space">{{room.players.length}}/6 人 · 每人 8 张起手牌</view>
 </block>
 <block wx:else>
  <view class="top"><button class="circle" data-action="leave" bindtap="action">‹</button><view class="center"><view class="heading">炸弹猫</view><view class="muted">房间号 {{room.code}}</view></view><button class="circle" data-action="settings" bindtap="action">⚙</button></view>
  <view class="game-room">
  <view class="board-stage"><view class="table-felt"/><view wx:for="{{v.tablePlayers}}" wx:key="id" class="table-seat {{item.isMe?'self-seat':''}} {{item.active && room.game.phase !== 'finished'?'active':''}} {{!item.alive?'out':''}}" style="{{item.seatStyle}}"><view class="avatar"><image src="/assets/ui.jpg" mode="widthFix" style="{{item.avatarStyle}}"/></view><view class="seat-info"><view class="strong">{{item.name}}{{item.isMe?' · 你':''}}</view><view>{{item.alive?item.count+' 张牌':'已出局'}}</view></view><view wx:if="{{item.active && room.game.phase !== 'finished'}}" class="turn-dot"/></view><view class="board-center"><view class="turn-label"><view class="blue strong">{{room.game.phase === 'finished'?v.winnerName+'获胜':v.phaseTitle}}</view><view wx:if="{{room.game.phase !== 'finished'}}">{{room.game.remaining}} 回合 · {{nopeInfo.done?'已响应':countdown === null?'∞':countdown+'s'}}</view><view wx:else>最后的幸存者 🐾</view></view><view class="piles"><view class="pile"><view class="card-back">🐾</view><view>牌堆 {{room.game.deckCount}}</view></view><view class="pile"><view wx:if="{{v.discard}}" class="card"><template is="card" data="{{card:v.discard}}"/></view><view wx:else class="empty-pile">出牌区</view><view>弃牌堆</view></view></view></view><view wx:for="{{motionItems}}" wx:key="renderId" wx:for-item="effect" class="motion-layer {{effect.kind}} {{settings.reduced?'reduced':''}}"><view class="motion-tile"><view wx:if="{{effect.actor}}" class="motion-people"><view class="avatar"><image src="/assets/ui.jpg" mode="widthFix" style="{{effect.actor.avatarStyle}}"/></view><text wx:if="{{effect.target}}">→</text><view wx:if="{{effect.target}}" class="avatar"><image src="/assets/ui.jpg" mode="widthFix" style="{{effect.target.avatarStyle}}"/></view></view><view wx:if="{{effect.relationship}}" class="motion-relationship">{{effect.relationship}}</view><view class="motion-action">{{effect.actionText || effect.title}}</view><view wx:if="{{effect.card}}" class="card"><template is="card" data="{{card:effect.card}}"/></view><view wx:if="{{effect.count > 1}}" class="motion-count">× {{effect.count}}</view></view></view></view>
  <view wx:if="{{v.deckTop || v.deckBottom}}" class="deck-hazards"><view wx:if="{{v.deckTop}}">✹ 牌顶：翻面内爆猫 · 抽到即出局</view><view wx:if="{{v.deckBottom}}">✹ 牌底：翻面内爆猫 · 抽到即出局</view></view>
  <view wx:if="{{room.game.phase === 'finished'}}" class="winner"><view class="heading">{{v.winnerName}}获胜</view><view class="muted space">这一次，幸运站在你这边。</view><button wx:if="{{v.isHost}}" class="primary" data-action="rematch" bindtap="action" disabled="{{busy}}">再来一局</button><view wx:else class="muted space">等待房主再开一局</view><button class="secondary" data-action="leave" bindtap="action">返回大厅</button></view>
  <view wx:else class="hand-area">
   <view wx:if="{{room.game.phase === 'future' && room.game.future && v.turn}}" class="phase"><view class="strong">悄悄看，只有你知道</view><view class="muted">从左到右，第一张是下一次会抽到的牌。</view><view class="future"><view class="card" wx:for="{{v.future}}" wx:key="id"><view class="muted center">第 {{index + 1}} 张</view><template is="card" data="{{card:item}}"/></view></view><button class="primary" data-action="closeFuture" bindtap="action" disabled="{{busy}}">看好了，继续</button></view>
   <view wx:if="{{room.game.phase === 'alterFuture' && futureState && v.turn}}" class="phase reorder-phase"><view class="strong">秘密调整未来</view><view class="muted">从上到下是牌顶顺序，第一张最先抽到。上下移动后确认，只有你能看到。</view><view class="future-order"><view wx:for="{{futureState.cards}}" wx:key="id" class="future-order-row"><text class="future-rank">{{index + 1}}</text><view class="card"><template is="card" data="{{card:item}}"/></view><view class="future-moves"><button class="secondary future-move" data-action="future-up" data-id="{{item.id}}" bindtap="action" disabled="{{busy || !item.canUp}}" aria-label="上移{{item.name}}">↑ 上移</button><button class="secondary future-move" data-action="future-down" data-id="{{item.id}}" bindtap="action" disabled="{{busy || !item.canDown}}" aria-label="下移{{item.name}}">↓ 下移</button></view></view></view><button class="primary" data-action="orderFuture" bindtap="action" disabled="{{busy || !futureState.canConfirm}}">确认顺序，继续回合</button></view>
   <view wx:if="{{room.game.phase === 'favor' && room.game.pending.target === v.myId}}" class="phase"><view class="strong">送出一张牌</view><view>在手牌中只选择一张，再点击交出。</view></view>
   <view wx:if="{{room.game.phase === 'defuse' && v.turn}}" class="phase"><view class="strong">抽到炸弹猫了！</view><view>用拆弹稳稳保命，再秘密放回炸弹。</view><button class="primary" data-action="defuse" bindtap="action" disabled="{{busy}}">使用拆弹</button></view>
   <view wx:if="{{room.game.phase === 'insert' && v.turn}}" class="phase"><view class="strong">{{v.insertTitle}}</view><view class="muted">{{v.insertHint}}</view><picker range="{{v.positions}}" range-key="label" value="{{positionIndex}}" bindchange="choosePosition"><view class="picker">{{v.positions[positionIndex].label}} ▾</view></picker><button class="primary" data-action="insert" bindtap="action" disabled="{{busy}}">确认放回</button></view>
   <view wx:if="{{!v.alive}}" class="notice">你已出局，正在旁观。你的手牌只对自己可见。</view>
   <view class="hand-caption"><text class="strong">手牌 {{v.hand.length}}</text><view class="hand-controls"><button class="text-btn hand-toggle" data-action="hand-toggle" bindtap="action" aria-expanded="{{handExpanded}}"><view class="hand-toggle-label"><text>{{handExpanded?"收起手牌":"展开手牌"}}</text><view class="hand-chevron {{handExpanded?'up':''}}" aria-hidden="true"/></view></button><button wx:if="{{selected.length}}" class="text-btn hand-toggle hand-clear" data-action="clear" bindtap="action" disabled="{{!selected.length}}"><view class="hand-toggle-label"><text>取消选择</text></view></button></view></view><scroll-view scroll-x class="hand {{handExpanded?'expanded':''}}" scroll-left="{{handScroll}}" bindscroll="handScrolled"><view class="hand-row" style="width: {{v.hand.length ? (handExpanded ? v.hand.length*224-12 : v.hand.length*86+126+selected.length*126) : 0}}rpx;"><button wx:for="{{v.hand}}" wx:key="id" class="card {{item.selected?'selected':''}} {{item.compactHand?'compact-hand':''}}" data-action="card" data-id="{{item.id}}" bindtap="action" aria-pressed="{{item.selected}}" aria-label="{{item.name}}，{{item.description}}"><view class="card-spine tone-{{item.spineTone}}">{{item.name}}</view><view class="card-check">✓</view><template is="card" data="{{card:item,hand:true}}"/></button></view></scroll-view>
   <view wx:if="{{selected.length}}" class="selection-preview"><view class="selection-title"><text>已选 {{selected.length}} 张 · <text wx:for="{{v.selectedCards}}" wx:key="id">{{item.name}} </text></text><button wx:if="{{selected.length === 1}}" class="text-btn" data-action="detail" bindtap="action">详情</button></view><view wx:if="{{!v.selection.valid && !v.canGive}}">{{v.selection.hint}}</view></view><view class="table-dock"><view class="nope-banner {{nopeInfo.canPass?'awaiting':''}} {{nopeInfo.canPass && !nopeInfo.unlimited && nopeInfo.remaining <= 3?'urgent':''}}" aria-label="{{nopeInfo.active?nopeInfo.actorName+' · '+nopeInfo.actionName+'；'+nopeInfo.stateText+'；'+nopeInfo.statusText:'当前没有可响应的动作'}}"><view class="nope-banner-copy"><view class="strong">是否选择否定？</view><view class="nope-timer-line"><view class="nope-progress"><view style="width:{{nopeInfo.progress || 0}}%;"/></view><text class="nope-timer-text">{{nopeInfo.timerText || ''}}</text></view></view><view class="nope-choices"><button class="secondary nope-choice nope-play" data-action="nope-response" data-window="{{nopeInfo.key}}" bindtap="action" disabled="{{busy || !nopeInfo.canNope}}">{{nopeInfo.buttonText || '打出否定'}}</button><button class="secondary nope-choice" data-action="nope-pass" data-window="{{nopeInfo.key}}" bindtap="action" disabled="{{busy || !nopeInfo.canPass}}">本次不出</button></view></view><view class="action-bar table-actions"><button wx:if="{{v.canGive}}" class="primary" data-action="give" bindtap="action" disabled="{{busy}}">交牌</button><button wx:else class="primary" data-action="prepare" bindtap="action" disabled="{{busy || !v.selection.valid}}">打出{{selected.length > 1?' · '+selected.length+' 张':''}}</button><button class="secondary" data-action="draw" bindtap="action" disabled="{{busy || !v.canDraw}}">抽牌</button></view></view>
  </view></view>
  <view class="logs"><view class="muted">对局动态</view><view wx:for="{{room.game.privateLog}}" wx:key="id" class="private-log">仅你可见 · {{item.text}}</view><view wx:for="{{room.game.logs}}" wx:key="id">{{item.text}}</view></view>
 </block>
 <view class="connection">{{connection}}</view>
</view>
<view wx:if="{{modal}}" class="modal-shade {{modal === 'play' || modal === 'create' || modal === 'close-room'?'centered':''}}"><scroll-view scroll-y class="sheet"><view class="sheet-content"><view class="modal-top"><button class="circle" data-action="close" bindtap="action" aria-label="关闭">×</button></view>

 <block wx:if="{{modal === 'create'}}"><view class="heading">一起开一局</view><view class="rule">设置好节奏，再邀请朋友入座。</view><view class="switch"><text>出牌不倒计时</text><switch checked="{{noTurnTimer}}" bindchange="roomSetting" color="#0071e3"/></view><view class="muted space">开启后，出牌、交牌、预知、调整未来、拆弹和插回都不限时；否定按下方设置响应。离线后由系统托管。</view><view class="setting-label">否定响应时长</view><view class="nope-options"><button wx:for="{{nopeTimes}}" wx:key="*this" class="nope-option {{nopeSeconds === item?'chosen':''}}" data-action="nope-time" data-seconds="{{item}}" bindtap="action" aria-pressed="{{nopeSeconds === item}}">{{item === 0?'不限时':item+' 秒'}}</button></view><view class="switch"><text>可循环否定</text><switch checked="{{allowNopeChain}}" data-field="allowNopeChain" bindchange="expansionSetting" color="#0071e3"/></view><view class="setting-note">开启后可否定上一张否定；每层独立响应</view><view class="setting-label">六人扩展规则</view><view class="setting-note">仅六人开局生效，2–5 人仍为基础版</view><view class="expansion-settings"><view class="switch"><text>加入内爆猫</text><switch checked="{{includeImploding}}" data-field="includeImploding" bindchange="expansionSetting" color="#0071e3"/></view><view class="switch"><text>加入反转</text><switch checked="{{includeReverse}}" data-field="includeReverse" bindchange="expansionSetting" color="#0071e3"/></view></view><view wx:if="{{!includeImploding}}" class="setting-note">关闭内爆猫时改用 5 张普通炸弹</view><button class="primary" data-action="create-submit" bindtap="action" disabled="{{busy}}">创建好友房</button></block>
 <block wx:if="{{modal === 'detail'}}"><view class="heading">{{v.detail.name}}</view><view class="detail-card"><view class="card"><template is="card" data="{{card:v.detail}}"/></view></view><view class="rule">{{v.detail.description}}</view></block>
 <block wx:if="{{modal === 'profile'}}"><view class="heading">选一只代表你的猫</view><view class="avatars"><button wx:for="{{avatars}}" wx:key="id" class="avatar {{avatar === item.id?'chosen':''}}" data-action="avatar" data-id="{{item.id}}" bindtap="action" aria-label="{{item.name}}"><image src="/assets/ui.jpg" mode="widthFix" style="{{item.style}}"/></button></view></block>
 <block wx:if="{{modal === 'join'}}"><view class="heading">加入朋友的房间</view><view class="muted space">六位房间号</view><input type="number" maxlength="6" value="{{code}}" placeholder="输入房间号" data-field="code" bindinput="input"/><button class="primary" data-action="join-submit" bindtap="action" disabled="{{busy}}" loading="{{busy}}">一起玩</button></block>
 <block wx:if="{{modal === 'bots'}}"><view class="heading">添加验证 Bot</view><view class="rule">Bot 会自动准备并参与对局。你仍需要点击准备，再开始游戏。</view><view class="muted">添加数量</view><picker range="{{v.botCounts}}" value="{{botCountIndex}}" bindchange="chooseBotCount"><view class="picker">{{botCount}} 位 Bot ▾</view></picker><view class="switch"><text>Bot 使用否定牌</text><switch checked="{{respondNope}}" bindchange="botSetting" color="#0071e3"/></view><view class="muted space">默认关闭，方便观察卡牌效果；开启后 Bot 会在响应窗口使用否定牌。</view><button class="primary" data-action="bots-submit" bindtap="action" disabled="{{busy || !v.canAddBots}}" loading="{{busy}}">添加 Bot</button></block>
 <block wx:if="{{modal === 'settings'}}"><view class="heading">按你的习惯</view><view class="switch"><text>回合提示音</text><switch checked="{{settings.sound}}" data-field="sound" bindchange="setting" color="#0071e3"/></view><view class="switch"><text>减弱动态</text><switch checked="{{settings.reduced}}" data-field="reduced" bindchange="setting" color="#0071e3"/></view><button class="secondary" data-action="rules" bindtap="action">玩法说明</button></block>
 <block wx:if="{{modal === 'rules'}}"><view class="heading">活到最后，就赢了</view><view class="rule">① 2–6 位朋友，每人 8 张牌，至少有 1 张拆弹。2–5 人用基础版，6 人加入完整内爆猫扩展。</view><view class="rule">② 轮到你，可以先出牌，再抽一张结束回合。抽到炸弹，拆弹保命；没有拆弹则出局。</view><view class="rule">③ 攻击把回合转给下家，跳过免抽一次。预知、索要、洗牌用完仍需继续行动。</view><view class="rule">④ 否定时长可选10、20、30秒或不限时，默认10秒。开启“可循环否定”后可反否定，每层独立响应。</view><view class="rule">⑤ 两张同名随机拿对方一张牌；三张同名指定想要的牌名，没有则落空。</view><view class="rule">⑥ 拆弹后可秘密放在任意位置，最后存活的猫咪获胜。</view><view class="rule">⑦ 超时会自动抽牌、拆弹或完成必选操作。断线不暂停整桌，回来可接管后续操作。</view><view class="rule">六人扩展：内爆猫首次翻面秘密插回，再抽到直接出局且不能拆弹。定向攻击可选自己；反转改变方向并免抽一个回合；抽牌底从底部抽牌；调整未来秘密重排前三张。野猫只替代普通猫组成组合。</view></block>
 <block wx:if="{{modal === 'play'}}"><view class="heading">{{v.selection.needsTarget?v.targetLabel:'确认出牌'}}</view><view class="play-preview"><view wx:for="{{v.selectedCards}}" wx:key="id" class="card"><template is="card" data="{{card:item}}"/></view></view><view class="rule">{{v.selection.hint}}</view><block wx:if="{{v.selection.needsTarget}}"><view class="muted">{{v.targetLabel}}</view><view class="targets"><button wx:for="{{v.targets}}" wx:key="id" class="target {{target === item.id?'chosen':''}}" data-action="target" data-id="{{item.id}}" bindtap="action" aria-pressed="{{target === item.id}}"><view class="avatar"><image src="/assets/ui.jpg" mode="widthFix" style="{{item.avatarStyle}}"/></view><view class="strong">{{item.name}}{{item.isMe?' · 你':''}}{{item.isBot?' · Bot':''}}</view><view>{{item.count}} 张牌</view></button></view></block><picker wx:if="{{v.selection.needsNamed}}" range="{{namedOptions}}" range-key="label" value="{{namedIndex}}" bindchange="chooseNamed"><view class="picker">声明牌名：{{namedOptions[namedIndex].label}} ▾</view></picker><button class="primary" data-action="play" bindtap="action" disabled="{{busy || !v.selection.valid || (v.selection.needsTarget && !target)}}">确认打出</button></block>
 <block wx:if="{{modal === 'leave'}}"><view class="heading">{{room.status === 'playing'?'暂时离开这一局？':'离开房间？'}}</view><view class="rule">{{room.status === 'playing'?'你的席位将由系统托管到本局结束。回来后可继续原局，期间不能加入其他房间。':'离开后可以重新创建或加入朋友的房间。'}}</view><button class="primary" data-action="leave-submit" bindtap="action" disabled="{{busy}}">{{v.isHost?'仅自己离开':'确认离开'}}</button><view wx:if="{{v.isHost}}" class="close-room-option"><view class="muted">也可以结束这桌游戏，让大家一起返回大厅。</view><button class="danger-secondary" data-action="close-room" bindtap="action" disabled="{{busy}}">关闭整个房间</button></view></block>
<block wx:if="{{modal === 'close-room'}}"><view class="heading">关闭整个房间？</view><view class="rule">当前对局将立即终止，不产生胜者。所有成员返回大厅，房间号失效。</view><view class="muted space">关闭后无法恢复这一局。</view><button class="danger-primary" data-action="close-room-submit" bindtap="action" disabled="{{busy}}" loading="{{busy}}">确认关闭房间</button><button class="secondary" data-action="close" bindtap="action" disabled="{{busy}}">继续游戏</button></block>
</view></scroll-view></view>
